# ------------------------------------------------------------------
# Copiar a .env y completar. NO subir .env al repositorio.
# ------------------------------------------------------------------

# Base de datos
# Local (Docker): postgresql://ranch:ranch@localhost:5432/ranch_texas?schema=public
# Railway: usar la DATABASE_URL que provee Railway
DATABASE_URL="postgresql://ranch:ranch@localhost:5432/ranch_texas?schema=public"

# Clave secreta para firmar los QR de las manillas (HMAC-SHA256).
# Generar una aleatoria larga. NO cambiarla en producción sin plan de rotación.
QR_HMAC_SECRET="cambia-esto-por-una-clave-larga-y-aleatoria"

# Clave para firmar la sesión (JWT en cookie httpOnly).
AUTH_SECRET="cambia-esto-por-otra-clave-larga-y-aleatoria"

# Zona horaria de operación
TZ="America/Bogota"

# Carpeta de exportación de CSV para Power BI (plan B)
EXPORT_DIR="./export"

# Usuario administrador inicial (lo crea el seed)
SEED_ADMIN_USUARIO="admin"
SEED_ADMIN_PASSWORD="Ranch2026*"

# ---------------------------------------------------------------- Cotizaciones
# Los eventos del día se arman en la app de Cotizaciones (07 - Cotizaciones) y
# aquí solo se consultan: no se copia nada a esta base. Sin estas variables la
# pantalla /eventos avisa que falta conectar y no muestra nada.
#
# COTIZACIONES_TOKEN debe ser EL MISMO valor de PROGRAMACION_TOKEN allá.
COTIZACIONES_URL="https://cotizaciones.up.railway.app"
COTIZACIONES_TOKEN="la misma cadena larga que allá"
# Slug de la empresa dentro de Cotizaciones.
COTIZACIONES_EMPRESA="ranch-texas"
# Razón social del parque, para no traer los menús del restaurante. Opcional:
# vacío trae todos los pedidos del día.
# COTIZACIONES_ENTIDAD="Parque Ranch Texas"
