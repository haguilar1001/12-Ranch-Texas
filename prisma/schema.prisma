// Esquema Prisma — Parque Ranch Texas
// Convenciones:
//  - Nombres de negocio en español; código técnico en inglés.
//  - Dinero SIEMPRE Int (COP entero, sin decimales).
//  - Nada se borra físicamente: baja lógica con `activo` o enums de estado.
//  - Auditoría transversal: creado_en/creado_por/actualizado_en/actualizado_por en cada tabla.
//    `creado_por` / `actualizado_por` guardan el id del usuario como String (sin FK, a propósito,
//    para no multiplicar back-relations sobre Usuario).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------- ENUMS -------------------------

enum Rol {
  administrador
  supervisor
  cajero
  control_acceso
  granja // operario de granja: solo el módulo de Animales
  consulta
}

enum EstadoManilla {
  activa
  usada
  anulada
  vencida
}

enum EstadoVenta {
  completada
  anulada
}

enum TipoLineaVenta {
  pago
  atencion
  invitacion
}

enum TipoMovCaja {
  apertura
  ingreso
  egreso
  cierre
}

enum EstadoTurno {
  abierto
  cerrado
  reabierto
}

enum EstadoGasto {
  pendiente
  pagado
  anulado
}

enum TipoReglaAcceso {
  un_ingreso
  reingreso
  entrada_salida
}

enum SentidoAcceso {
  entrada
  salida
}

enum ResultadoAcceso {
  permitido
  denegado
}

enum NivelRubro {
  grupo
  rubro
  subrubro
}

enum TipoGasto {
  unico
  recurrente
}

enum EstadoImpresion {
  pendiente
  impreso
  fallido
}

// ------------------------- USUARIOS Y CAJA -------------------------

model Usuario {
  id             String    @id @default(uuid())
  nombre         String
  usuario        String    @unique
  hash_password  String
  rol            Rol
  activo         Boolean   @default(true)
  ultimo_ingreso DateTime?

  turnos TurnoCaja[]
  ventas Venta[]

  creado_en       DateTime @default(now())
  creado_por      String?
  actualizado_en  DateTime @updatedAt
  actualizado_por String?

  @@map("usuarios")
}

model Caja {
  id        String  @id @default(uuid())
  nombre    String
  ubicacion String?
  activo    Boolean @default(true)

  turnos TurnoCaja[]

  creado_en       DateTime @default(now())
  creado_por      String?
  actualizado_en  DateTime @updatedAt
  actualizado_por String?

  @@map("cajas")
}

model TurnoCaja {
  id                 String      @id @default(uuid())
  caja_id            String
  usuario_id         String
  base_inicial       Int         @default(0)
  abierto_en         DateTime    @default(now())
  cerrado_en         DateTime?
  estado             EstadoTurno @default(abierto)
  efectivo_esperado  Int?
  efectivo_contado   Int?
  diferencia         Int?
  observacion_cierre String?
  reabierto_por      String?
  reabierto_en       DateTime?

  caja        Caja                 @relation(fields: [caja_id], references: [id])
  usuario     Usuario              @relation(fields: [usuario_id], references: [id])
  movimientos MovimientoCaja[]
  conteos     ConteoDenominacion[]
  ventas      Venta[]

  creado_en       DateTime @default(now())
  creado_por      String?
  actualizado_en  DateTime @updatedAt
  actualizado_por String?

  @@index([caja_id, estado])
  @@index([abierto_en])
  @@map("turnos_caja")
}

model MovimientoCaja {
  id            String      @id @default(uuid())
  turno_id      String
  tipo          TipoMovCaja
  monto         Int
  concepto      String
  medio_pago_id String?
  venta_id      String?
  referencia    String?

  turno      TurnoCaja  @relation(fields: [turno_id], references: [id])
  medio_pago MedioPago? @relation(fields: [medio_pago_id], references: [id])

  creado_en       DateTime @default(now())
  creado_por      String?
  actualizado_en  DateTime @updatedAt
  actualizado_por String?

  @@index([turno_id, tipo])
  @@map("movimientos_caja")
}

model ConteoDenominacion {
  id           String @id @default(uuid())
  turno_id     String
  denominacion Int
  cantidad     Int

  turno TurnoCaja @relation(fields: [turno_id], references: [id])

  creado_en       DateTime @default(now())
  creado_por      String?
  actualizado_en  DateTime @updatedAt
  actualizado_por String?

  @@index([turno_id])
  @@map("conteo_denominaciones")
}

// ------------------------- CATÁLOGOS DE VENTA -------------------------

model TipoVisitante {
  id            String  @id @default(uuid())
  nombre        String
  codigo        String  @unique
  requiere_pago Boolean @default(true)
  edad_min      Int?
  edad_max      Int?
  orden         Int     @default(0)
  activo        Boolean @default(true)

  tarifas  Tarifa[]
  detalle  VentaDetalle[]
  manillas Manilla[]

  creado_en       DateTime @default(now())
  creado_por      String?
  actualizado_en  DateTime @updatedAt
  actualizado_por String?

  @@map("tipos_visitante")
}

model Tarifa {
  id                String    @id @default(uuid())
  tipo_visitante_id String
  valor             Int
  vigente_desde     DateTime
  vigente_hasta     DateTime?
  motivo_cambio     String?

  tipo_visitante TipoVisitante  @relation(fields: [tipo_visitante_id], references: [id])
  detalle        VentaDetalle[]

  creado_en       DateTime @default(now())
  creado_por      String?
  actualizado_en  DateTime @updatedAt
  actualizado_por String?

  @@index([tipo_visitante_id, vigente_desde])
  @@map("tarifas")
}

model MotivoCortesia {
  id                    String  @id @default(uuid())
  nombre                String
  requiere_autorizacion Boolean @default(true)
  activo                Boolean @default(true)

  detalle VentaDetalle[]

  creado_en       DateTime @default(now())
  creado_por      String?
  actualizado_en  DateTime @updatedAt
  actualizado_por String?

  @@map("motivos_cortesia")
}

model MedioPago {
  id          String  @id @default(uuid())
  nombre      String
  codigo      String  @unique
  es_efectivo Boolean @default(false)
  orden       Int     @default(0)
  activo      Boolean @default(true)

  pagos       VentaPago[]
  movimientos MovimientoCaja[]
  gastos      Gasto[]

  creado_en       DateTime @default(now())
  creado_por      String?
  actualizado_en  DateTime @updatedAt
  actualizado_por String?

  @@map("medios_pago")
}

// ------------------------- VENTAS -------------------------

model Venta {
  id                  String      @id @default(uuid())
  turno_id            String
  usuario_id          String
  numero_venta        Int
  total_lista         Int         @default(0)
  total_cobrado       Int         @default(0)
  total_descuento     Int         @default(0)
  cantidad_asistentes Int         @default(0)
  estado              EstadoVenta @default(completada)
  motivo_anulacion    String?
  anulada_por         String?
  anulada_en          DateTime?

  // Datos opcionales del comprador (configurable)
  comprador_nombre    String?
  comprador_documento String?

  turno   TurnoCaja      @relation(fields: [turno_id], references: [id])
  usuario Usuario        @relation(fields: [usuario_id], references: [id])
  detalle VentaDetalle[]
  pagos   VentaPago[]

  creado_en       DateTime @default(now())
  creado_por      String?
  actualizado_en  DateTime @updatedAt
  actualizado_por String?

  @@unique([turno_id, numero_venta])
  @@index([creado_en])
  @@map("ventas")
}

model VentaDetalle {
  id                 String         @id @default(uuid())
  venta_id           String
  tipo_visitante_id  String
  tarifa_id          String?
  tipo_linea         TipoLineaVenta @default(pago)
  cantidad           Int
  valor_lista        Int // por unidad
  valor_cobrado      Int // por unidad (valor_lista - descuento)
  motivo_descuento   String?
  autorizado_por     String?
  motivo_cortesia_id String?

  venta           Venta           @relation(fields: [venta_id], references: [id])
  tipo_visitante  TipoVisitante   @relation(fields: [tipo_visitante_id], references: [id])
  tarifa          Tarifa?         @relation(fields: [tarifa_id], references: [id])
  motivo_cortesia MotivoCortesia? @relation(fields: [motivo_cortesia_id], references: [id])
  manillas        Manilla[]

  creado_en       DateTime @default(now())
  creado_por      String?
  actualizado_en  DateTime @updatedAt
  actualizado_por String?

  @@index([venta_id])
  @@map("venta_detalle")
}

model VentaPago {
  id            String  @id @default(uuid())
  venta_id      String
  medio_pago_id String
  monto         Int
  referencia    String?

  venta      Venta     @relation(fields: [venta_id], references: [id])
  medio_pago MedioPago @relation(fields: [medio_pago_id], references: [id])

  creado_en       DateTime @default(now())
  creado_por      String?
  actualizado_en  DateTime @updatedAt
  actualizado_por String?

  @@index([venta_id])
  @@map("venta_pagos")
}

model Manilla {
  id                String        @id @default(uuid())
  codigo_uuid       String        @unique
  firma_hmac        String
  consecutivo       String // corto y legible por si el QR se daña
  venta_detalle_id  String
  tipo_visitante_id String
  estado            EstadoManilla @default(activa)
  es_bebe           Boolean       @default(false)
  vencimiento       DateTime?
  usada_en          DateTime?
  anulada_en        DateTime?
  anulada_por       String?
  motivo_anulacion  String?
  reimpresa_veces   Int           @default(0)

  venta_detalle   VentaDetalle     @relation(fields: [venta_detalle_id], references: [id])
  tipo_visitante  TipoVisitante    @relation(fields: [tipo_visitante_id], references: [id])
  accesos         Acceso[]
  consentimientos Consentimiento[]
  impresiones     Impresion[]
  turnos_fila     TurnoFila[]

  creado_en       DateTime @default(now())
  creado_por      String?
  actualizado_en  DateTime @updatedAt
  actualizado_por String?

  @@index([estado])
  @@index([venta_detalle_id])
  @@map("manillas")
}

// ------------------------- ACCESO -------------------------

// Estado de un turno en la fila virtual de una atracción.
enum EstadoTurnoFila {
  esperando
  llamado
  atendido
  no_se_presento
  cancelado
}

model Atraccion {
  id                      String  @id @default(uuid())
  nombre                  String
  descripcion             String?
  edad_minima             Int?
  edad_maxima             Int?
  estatura_minima         Int? // cm
  estatura_maxima         Int? // cm — hay atracciones con tope: en Motocross no cabe alguien muy alto
  peso_minimo             Int? // kg
  peso_maximo             Int? // kg
  requiere_consentimiento Boolean @default(false)
  activa                  Boolean @default(true)

  // --- Fila virtual: reemplaza la lista de papel donde la gente se anota y tiene
  // que quedarse parada esperando a que la llamen.
  fila_activa       Boolean @default(false)
  cupo_por_tanda    Int? // cuántas personas entran por vuelta (p. ej. 8 karts)
  minutos_por_tanda Int? // cuánto dura una vuelta; con el cupo se estima la espera

  puntos_control  PuntoControl[]
  consentimientos Consentimiento[]
  textos          TextoConsentimiento[]
  turnos_fila     TurnoFila[]

  creado_en       DateTime @default(now())
  creado_por      String?
  actualizado_en  DateTime @updatedAt
  actualizado_por String?

  @@map("atracciones")
}

/**
 * Un puesto en la fila de una atracción, atado a la manilla del visitante.
 * El consecutivo se reinicia cada día operativo y por atracción, que es como se
 * canta en voz alta ("va el 41").
 */
model TurnoFila {
  id              String          @id @default(uuid())
  atraccion_id    String
  manilla_id      String
  numero          Int
  fecha_operativa String // YYYY-MM-DD en Bogotá; junto al número forma el consecutivo del día
  personas        Int             @default(1)
  estado          EstadoTurnoFila @default(esperando)
  tomado_en       DateTime        @default(now())
  llamado_en      DateTime?
  cerrado_en      DateTime? // atendido, no se presentó o cancelado
  motivo          String?

  atraccion Atraccion @relation(fields: [atraccion_id], references: [id])
  manilla   Manilla   @relation(fields: [manilla_id], references: [id])

  creado_en       DateTime @default(now())
  creado_por      String?
  actualizado_en  DateTime @updatedAt
  actualizado_por String?

  @@unique([atraccion_id, fecha_operativa, numero])
  @@index([atraccion_id, estado])
  @@index([manilla_id])
  @@index([fecha_operativa])
  @@map("turnos_fila")
}

model PuntoControl {
  id                      String          @id @default(uuid())
  nombre                  String
  atraccion_id            String?
  tipo_regla              TipoReglaAcceso @default(entrada_salida)
  edad_minima             Int?
  estatura_minima         Int?
  requiere_consentimiento Boolean         @default(false)
  aforo_maximo            Int?
  activo                  Boolean         @default(true)

  atraccion Atraccion? @relation(fields: [atraccion_id], references: [id])
  accesos   Acceso[]

  creado_en       DateTime @default(now())
  creado_por      String?
  actualizado_en  DateTime @updatedAt
  actualizado_por String?

  @@map("puntos_control")
}

model Acceso {
  id                String          @id @default(uuid())
  manilla_id        String?
  punto_control_id  String
  resultado         ResultadoAcceso
  sentido           SentidoAcceso?
  motivo_denegacion String?
  escaneado_por     String?
  dispositivo       String?
  escaneado_en      DateTime // hora del evento (dispositivo)
  registrado_en     DateTime        @default(now()) // llegada al servidor
  sincronizado      Boolean         @default(true)
  id_cliente        String?         @unique // idempotencia de la cola offline

  manilla       Manilla?     @relation(fields: [manilla_id], references: [id])
  punto_control PuntoControl @relation(fields: [punto_control_id], references: [id])

  creado_en       DateTime @default(now())
  creado_por      String?
  actualizado_en  DateTime @updatedAt
  actualizado_por String?

  @@index([punto_control_id, escaneado_en])
  @@index([manilla_id])
  @@index([sincronizado])
  @@map("accesos")
}

// ------------------------- CONSENTIMIENTOS -------------------------

model TextoConsentimiento {
  id            String    @id @default(uuid())
  codigo        String // agrupa versiones del mismo documento
  version       Int
  titulo        String
  cuerpo        String    @db.Text
  atraccion_id  String?
  vigente_desde DateTime  @default(now())
  vigente_hasta DateTime?
  activo        Boolean   @default(true)

  atraccion       Atraccion?       @relation(fields: [atraccion_id], references: [id])
  consentimientos Consentimiento[]

  creado_en       DateTime @default(now())
  creado_por      String?
  actualizado_en  DateTime @updatedAt
  actualizado_por String?

  @@unique([codigo, version])
  @@map("textos_consentimiento")
}

model Consentimiento {
  id                      String   @id @default(uuid())
  manilla_id              String
  atraccion_id            String
  texto_consentimiento_id String
  es_menor                Boolean  @default(false)
  nombre_firmante         String
  documento_firmante      String
  nombre_acudiente        String?
  documento_acudiente     String?
  parentesco              String?
  firma_imagen            String   @db.Text // PNG base64 del canvas
  ip                      String?
  dispositivo             String?
  user_agent              String?
  firmado_en              DateTime @default(now())

  manilla   Manilla             @relation(fields: [manilla_id], references: [id])
  atraccion Atraccion           @relation(fields: [atraccion_id], references: [id])
  texto     TextoConsentimiento @relation(fields: [texto_consentimiento_id], references: [id])

  creado_en       DateTime @default(now())
  creado_por      String?
  actualizado_en  DateTime @updatedAt
  actualizado_por String?

  @@index([manilla_id])
  @@index([atraccion_id])
  @@map("consentimientos")
}

// ------------------------- GASTOS -------------------------

model Proveedor {
  id         String  @id @default(uuid())
  nombre     String
  nit_cedula String?
  contacto   String?
  telefono   String?
  email      String?
  activo     Boolean @default(true)

  gastos      Gasto[]
  recurrentes GastoRecurrente[]

  creado_en       DateTime @default(now())
  creado_por      String?
  actualizado_en  DateTime @updatedAt
  actualizado_por String?

  @@map("proveedores")
}

model RubroGasto {
  id       String     @id @default(uuid())
  nombre   String
  nivel    NivelRubro
  padre_id String?
  orden    Int        @default(0)
  activo   Boolean    @default(true)

  padre RubroGasto?  @relation("Jerarquia", fields: [padre_id], references: [id])
  hijos RubroGasto[] @relation("Jerarquia")

  gastos       Gasto[]
  recurrentes  GastoRecurrente[]
  presupuestos Presupuesto[]

  creado_en       DateTime @default(now())
  creado_por      String?
  actualizado_en  DateTime @updatedAt
  actualizado_por String?

  @@index([padre_id])
  @@map("rubros_gasto")
}

model Gasto {
  id                String      @id @default(uuid())
  proveedor_id      String?
  rubro_gasto_id    String
  descripcion       String
  fecha_gasto       DateTime
  base_gravable     Int         @default(0)
  iva               Int         @default(0)
  retefuente        Int         @default(0)
  reteica           Int         @default(0)
  otras_retenciones Int         @default(0)
  total             Int         @default(0)
  estado            EstadoGasto @default(pendiente)
  tipo              TipoGasto   @default(unico)
  plantilla_id      String?
  soporte_archivo   String?
  pagado_en         DateTime?
  medio_pago_id     String?

  proveedor  Proveedor?       @relation(fields: [proveedor_id], references: [id])
  rubro      RubroGasto       @relation(fields: [rubro_gasto_id], references: [id])
  plantilla  GastoRecurrente? @relation(fields: [plantilla_id], references: [id])
  medio_pago MedioPago?       @relation(fields: [medio_pago_id], references: [id])

  creado_en       DateTime @default(now())
  creado_por      String?
  actualizado_en  DateTime @updatedAt
  actualizado_por String?

  @@index([rubro_gasto_id])
  @@index([fecha_gasto])
  @@index([estado])
  @@map("gastos")
}

model GastoRecurrente {
  id             String  @id @default(uuid())
  rubro_gasto_id String
  proveedor_id   String?
  descripcion    String
  monto_estimado Int
  dia_del_mes    Int
  activo         Boolean @default(true)

  rubro     RubroGasto @relation(fields: [rubro_gasto_id], references: [id])
  proveedor Proveedor? @relation(fields: [proveedor_id], references: [id])
  gastos    Gasto[]

  creado_en       DateTime @default(now())
  creado_por      String?
  actualizado_en  DateTime @updatedAt
  actualizado_por String?

  @@map("gastos_recurrentes")
}

model Presupuesto {
  id                  String @id @default(uuid())
  rubro_gasto_id      String
  anio                Int
  mes                 Int? // null = presupuesto anual
  monto_presupuestado Int

  rubro RubroGasto @relation(fields: [rubro_gasto_id], references: [id])

  creado_en       DateTime @default(now())
  creado_por      String?
  actualizado_en  DateTime @updatedAt
  actualizado_por String?

  @@unique([rubro_gasto_id, anio, mes])
  @@map("presupuesto")
}

// ------------------------- INFRAESTRUCTURA -------------------------

model Impresion {
  id         String          @id @default(uuid())
  manilla_id String?
  tipo       String // "manilla" | "cierre"
  payload    String          @db.Text
  estado     EstadoImpresion @default(pendiente)
  intentos   Int             @default(0)
  error      String?
  impreso_en DateTime?

  manilla Manilla? @relation(fields: [manilla_id], references: [id])

  creado_en       DateTime @default(now())
  creado_por      String?
  actualizado_en  DateTime @updatedAt
  actualizado_por String?

  @@index([estado])
  @@map("impresiones")
}

model LogAuditoria {
  id            String   @id @default(uuid())
  usuario_id    String?
  entidad       String
  entidad_id    String
  accion        String // crear, anular, reabrir, reimprimir, cambio_tarifa, descuento, login...
  datos_antes   Json?
  datos_despues Json?
  ip            String?
  creado_en     DateTime @default(now())

  @@index([entidad, entidad_id])
  @@index([usuario_id, creado_en])
  @@map("log_auditoria")
}

// ------------------------- DIMENSIÓN FECHA (analítica) -------------------------
// Tabla física para reportes y Power BI. Se puebla con scripts/gen-dim-fecha.ts.
// Solo lleva banderas informativas; NO restringe la operación (el parque abre entre
// semana cuando hay eventos).

model DimFecha {
  fecha             DateTime @id @db.Date
  anio              Int
  mes               Int
  dia               Int
  trimestre         Int
  semana_iso        Int
  nombre_dia        String
  nombre_mes        String
  dia_semana        Int // 1=lunes ... 7=domingo
  es_fin_semana     Boolean
  es_festivo        Boolean  @default(false)
  nombre_festivo    String?
  es_temporada_alta Boolean  @default(false)

  @@index([anio, mes])
  @@map("dim_fecha")
}

// ------------------------- VENTAS HISTÓRICAS (importadas de Excel) -------------------------
// Ingresos históricos por fecha y línea de producto, cargados desde el Excel de operación
// anterior (no transaccional). Alimenta los comparativos año vs año en Power BI junto a los
// datos en vivo. Se refresca por completo desde el archivo fuente (ver scripts/import-historico.ts).

model VentaHistorica {
  id       String   @id @default(uuid())
  fecha    DateTime @db.Date
  anio     Int
  mes      Int
  producto String
  valor    Int // COP entero
  negocio  String   @default("RANCH TEXAS")
  origen   String // archivo/fuente de origen

  creado_en DateTime @default(now())

  @@index([fecha])
  @@index([anio, mes])
  @@index([producto])
  @@map("ventas_historicas")
}

// ============================================================================
//  MÓDULOS OPERATIVOS (F10) — Personal, Animales, Equipos
//  Maestros/parámetros que se afinan con datos reales (carga por Excel).
//  Convenciones: español en negocio, dinero Int, baja lógica (`activo`/estado),
//  auditoría transversal en cada tabla.
// ============================================================================

// ------------------------- PERSONAL -------------------------

enum EstadoEmpleado {
  activo
  inactivo
  retirado
}

model AreaTrabajo {
  id          String  @id @default(uuid())
  nombre      String
  descripcion String?
  activo      Boolean @default(true)

  cargos    Cargo[]
  empleados Empleado[]
  equipos   Equipo[]

  creado_en       DateTime @default(now())
  creado_por      String?
  actualizado_en  DateTime @updatedAt
  actualizado_por String?

  @@map("areas_trabajo")
}

model Cargo {
  id      String  @id @default(uuid())
  nombre  String
  area_id String?
  activo  Boolean @default(true)

  area      AreaTrabajo? @relation(fields: [area_id], references: [id])
  empleados Empleado[]

  creado_en       DateTime @default(now())
  creado_por      String?
  actualizado_en  DateTime @updatedAt
  actualizado_por String?

  @@index([area_id])
  @@map("cargos")
}

model Empleado {
  id             String         @id @default(uuid())
  nombre         String
  tipo_documento String? // CC, CE, PA...
  documento      String?        @unique
  cargo_id       String?
  area_id        String?
  telefono       String?
  email          String?
  fecha_ingreso  DateTime?
  fecha_retiro   DateTime?
  estado         EstadoEmpleado @default(activo)
  /// Unidad de negocio de la nómina: Parque o Caballos. No es lo mismo que el área:
  /// alguien de Administración puede estar en la nómina de Caballos.
  unidad_negocio String?
  /// Salario base mensual en COP entero. Dato sensible: solo supervisor hacia arriba.
  salario_base   Int?
  usuario_id     String? // enlace opcional al Usuario del sistema (login)
  observaciones  String?
  activo         Boolean        @default(true)

  cargo Cargo?       @relation(fields: [cargo_id], references: [id])
  area  AreaTrabajo? @relation(fields: [area_id], references: [id])

  creado_en       DateTime @default(now())
  creado_por      String?
  actualizado_en  DateTime @updatedAt
  actualizado_por String?

  @@index([area_id])
  @@index([cargo_id])
  @@map("empleados")
}

// ------------------------- ANIMALES -------------------------

enum SexoAnimal {
  macho
  hembra
  desconocido
}

enum EstadoAnimal {
  activo
  enfermo
  cuarentena
  fallecido
  trasladado
}

// ¿La cantidad de la ración es por cabeza o el total que se entrega al lote?
enum ModoRacion {
  individual // cantidad POR ANIMAL → el consumo se multiplica por las cabezas del grupo
  grupal // cantidad TOTAL para todo el lote/recinto, sin importar cuántas cabezas
}

// Período al que corresponde `Racion.cantidad`.
enum FrecuenciaRacion {
  diaria
  semanal
  quincenal
  mensual
}

enum EstadoAlimentacion {
  realizada
  parcial
  omitida
}

enum TipoMovimientoAlimento {
  entrada // compra / donación / ingreso a bodega
  salida // entrega a los animales (bitácora) o merma
  ajuste // corrección de inventario por conteo físico
}

model CategoriaAnimal {
  id          String  @id @default(uuid())
  nombre      String // Aves, Equinos, Bovinos, Reptiles...
  descripcion String?
  activo      Boolean @default(true)

  animales       Animal[]
  raciones       Racion[]
  alimentaciones RegistroAlimentacion[]

  creado_en       DateTime @default(now())
  creado_por      String?
  actualizado_en  DateTime @updatedAt
  actualizado_por String?

  @@map("categorias_animal")
}

model Recinto {
  id          String  @id @default(uuid())
  nombre      String // Corral 1, Establo, Aviario...
  tipo        String? // corral, establo, aviario, estanque, jaula, potrero...
  ubicacion   String? // zona del parque (granja, lago, zona norte...)
  descripcion String?
  capacidad   Int?
  activo      Boolean @default(true)

  animales          Animal[]
  traslados_origen  TrasladoAnimal[]       @relation("traslado_origen")
  traslados_destino TrasladoAnimal[]       @relation("traslado_destino")
  alimentaciones    RegistroAlimentacion[]

  creado_en       DateTime @default(now())
  creado_por      String?
  actualizado_en  DateTime @updatedAt
  actualizado_por String?

  @@map("recintos")
}

model Animal {
  id               String       @id @default(uuid())
  nombre           String
  codigo           String? // chapeta / identificador físico
  categoria_id     String
  recinto_id       String? // ubicación ACTUAL (el historial está en traslados_animal)
  cantidad         Int          @default(1) // headcount del grupo/lote (1 = individuo)
  especie          String?
  raza             String?
  sexo             SexoAnimal   @default(desconocido)
  fecha_nacimiento DateTime?
  fecha_ingreso    DateTime?
  estado           EstadoAnimal @default(activo)
  observaciones    String?
  activo           Boolean      @default(true)

  categoria      CategoriaAnimal        @relation(fields: [categoria_id], references: [id])
  recinto        Recinto?               @relation(fields: [recinto_id], references: [id])
  raciones       Racion[]
  traslados      TrasladoAnimal[]
  alimentaciones RegistroAlimentacion[]

  creado_en       DateTime @default(now())
  creado_por      String?
  actualizado_en  DateTime @updatedAt
  actualizado_por String?

  @@index([categoria_id])
  @@index([recinto_id])
  @@map("animales")
}

// Historial de ubicación: cada movimiento de un grupo/animal entre recintos.
model TrasladoAnimal {
  id                 String   @id @default(uuid())
  animal_id          String
  recinto_origen_id  String? // null = primera ubicación asignada
  recinto_destino_id String
  cantidad           Int      @default(1) // cabezas trasladadas
  fecha              DateTime @default(now())
  motivo             String?

  animal          Animal   @relation(fields: [animal_id], references: [id])
  recinto_origen  Recinto? @relation("traslado_origen", fields: [recinto_origen_id], references: [id])
  recinto_destino Recinto  @relation("traslado_destino", fields: [recinto_destino_id], references: [id])

  creado_en       DateTime @default(now())
  creado_por      String?
  actualizado_en  DateTime @updatedAt
  actualizado_por String?

  @@index([animal_id])
  @@index([recinto_destino_id])
  @@index([fecha])
  @@map("traslados_animal")
}

model Alimento {
  id              String  @id @default(uuid())
  nombre          String
  tipo            String? // concentrado, forraje, fruta, verdura...
  unidad_medida   String  @default("kg") // unidad de COMPRA: bulto, kg, litro, unidad
  costo_unitario  Int? // COP por unidad_medida
  equivalencia_g  Int? // gramos (o ml) que trae una unidad de compra; null si es indivisible
  existencia_base Int? // stock en unidad BASE (g/ml/unidad), recalculable desde movimientos
  activo          Boolean @default(true)

  raciones       Racion[]
  movimientos    MovimientoAlimento[]
  alimentaciones RegistroAlimentacion[]

  creado_en       DateTime @default(now())
  creado_por      String?
  actualizado_en  DateTime @updatedAt
  actualizado_por String?

  @@map("alimentos")
}

// Dieta (parámetro): qué come una categoría (o un animal/grupo específico), cuánto,
// cada cuánto y si la cantidad es por cabeza (individual) o para todo el lote (grupal).
model Racion {
  id                  String           @id @default(uuid())
  categoria_animal_id String?
  animal_id           String?
  alimento_id         String
  cantidad            Int // en la unidad de abajo; entero (usar g para fracciones de kg)
  unidad              String           @default("kg")
  modo                ModoRacion       @default(grupal)
  frecuencia          FrecuenciaRacion @default(diaria)
  horario             String? // "6:00 a.m.", "mañana y tarde"...
  observaciones       String?
  activo              Boolean          @default(true)

  categoria      CategoriaAnimal?       @relation(fields: [categoria_animal_id], references: [id])
  animal         Animal?                @relation(fields: [animal_id], references: [id])
  alimento       Alimento               @relation(fields: [alimento_id], references: [id])
  alimentaciones RegistroAlimentacion[]

  creado_en       DateTime @default(now())
  creado_por      String?
  actualizado_en  DateTime @updatedAt
  actualizado_por String?

  @@index([categoria_animal_id])
  @@index([animal_id])
  @@map("raciones")
}

// Bitácora: cada entrega real de alimento (o su omisión justificada).
model RegistroAlimentacion {
  id                  String             @id @default(uuid())
  fecha               DateTime           @default(now()) // hora real de la entrega (UTC)
  racion_id           String? // dieta que se estaba cumpliendo; null = entrega extraordinaria
  animal_id           String?
  categoria_animal_id String?
  recinto_id          String?
  alimento_id         String
  cantidad_planeada   Int? // en unidad base (g/ml/unidad), calculada desde la ración
  cantidad_entregada  Int // en unidad base (g/ml/unidad)
  costo               Int? // COP de lo entregado, si el alimento tiene costo unitario
  estado              EstadoAlimentacion @default(realizada)
  motivo              String? // obligatorio si es parcial u omitida
  empleado_id         String? // quién alimentó
  usuario_id          String? // quién lo registró en el sistema
  observaciones       String?
  anulado             Boolean            @default(false)
  motivo_anulacion    String?

  racion     Racion?             @relation(fields: [racion_id], references: [id])
  animal     Animal?             @relation(fields: [animal_id], references: [id])
  categoria  CategoriaAnimal?    @relation(fields: [categoria_animal_id], references: [id])
  recinto    Recinto?            @relation(fields: [recinto_id], references: [id])
  alimento   Alimento            @relation(fields: [alimento_id], references: [id])
  movimiento MovimientoAlimento?

  creado_en       DateTime @default(now())
  creado_por      String?
  actualizado_en  DateTime @updatedAt
  actualizado_por String?

  @@index([fecha])
  @@index([animal_id])
  @@index([alimento_id])
  @@index([recinto_id])
  @@map("registros_alimentacion")
}

// Kardex del alimento. La existencia del alimento se recalcula desde aquí.
model MovimientoAlimento {
  id              String                 @id @default(uuid())
  alimento_id     String
  tipo            TipoMovimientoAlimento
  cantidad_base   Int // entrada/salida: cantidad positiva. ajuste: NUEVO saldo contado
  fecha           DateTime               @default(now())
  motivo          String?
  costo           Int? // COP del movimiento (compras)
  alimentacion_id String?                @unique // salida generada por una entrega de la bitácora

  alimento     Alimento              @relation(fields: [alimento_id], references: [id])
  alimentacion RegistroAlimentacion? @relation(fields: [alimentacion_id], references: [id])

  creado_en       DateTime @default(now())
  creado_por      String?
  actualizado_en  DateTime @updatedAt
  actualizado_por String?

  @@index([alimento_id])
  @@index([fecha])
  @@map("movimientos_alimento")
}

// ------------------------- EQUIPOS -------------------------

enum EstadoEquipo {
  operativo
  en_mantenimiento
  fuera_servicio
  dado_de_baja
}

enum TipoMantenimiento {
  preventivo
  correctivo
}

enum EstadoMantenimiento {
  programado
  en_proceso
  realizado
  cancelado
}

model CategoriaEquipo {
  id          String  @id @default(uuid())
  nombre      String // Plantas eléctricas, Bombas, Aires acondicionados, Sonido...
  descripcion String?
  activo      Boolean @default(true)

  equipos Equipo[]

  creado_en       DateTime @default(now())
  creado_por      String?
  actualizado_en  DateTime @updatedAt
  actualizado_por String?

  @@map("categorias_equipo")
}

model Equipo {
  id                String       @id @default(uuid())
  nombre            String
  codigo            String? // placa / consecutivo interno
  categoria_id      String
  area_id           String?
  ubicacion         String?
  marca             String?
  modelo            String?
  serie             String?
  fecha_compra      DateTime?
  fecha_instalacion DateTime?
  estado            EstadoEquipo @default(operativo)
  observaciones     String?
  activo            Boolean      @default(true)

  categoria      CategoriaEquipo       @relation(fields: [categoria_id], references: [id])
  area           AreaTrabajo?          @relation(fields: [area_id], references: [id])
  mantenimientos MantenimientoEquipo[]

  creado_en       DateTime @default(now())
  creado_por      String?
  actualizado_en  DateTime @updatedAt
  actualizado_por String?

  @@index([categoria_id])
  @@index([area_id])
  @@map("equipos")
}

model MantenimientoEquipo {
  id               String              @id @default(uuid())
  equipo_id        String
  tipo             TipoMantenimiento   @default(preventivo)
  descripcion      String
  fecha_programada DateTime?
  fecha_realizada  DateTime?
  costo            Int                 @default(0)
  responsable      String? // empleado o proveedor (texto libre en el boceto)
  estado           EstadoMantenimiento @default(programado)

  equipo Equipo @relation(fields: [equipo_id], references: [id])

  creado_en       DateTime @default(now())
  creado_por      String?
  actualizado_en  DateTime @updatedAt
  actualizado_por String?

  @@index([equipo_id])
  @@index([estado])
  @@map("mantenimientos_equipo")
}
